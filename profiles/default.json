{
  "name": "default",
  "description": "Balanced tiering for SDLC and utility agents",
  "tiers": {
    "orchestration": {
      "description": "Primary and domain coordinators; strongest model",
      "variant": "high",
      "agents": ["sdlc-orchestrator", "deep-planner", "architect", "orchestraitor", "orchestralite", "review-coordinator"]
    },
    "implementation": {
      "description": "Code-writing agents",
      "variant": null,
      "agents": ["sdd-implement", "jd-fix"]
    },
    "analysis": {
      "description": "Read-heavy exploration and inspection",
      "variant": null,
      "agents": ["sdd-explore", "arch-analyzer", "refactor-analyzer", "boundary-inspector"]
    },
    "verification": {
      "description": "Independent verification",
      "variant": "high",
      "agents": ["sdd-verify", "lite-verify"]
    },
    "judge-a": {
      "description": "Blind judge A; keep provider distinct from judge-b",
      "variant": "high",
      "agents": ["jd-judge-a"]
    },
    "judge-b": {
      "description": "Blind judge B; keep provider distinct from judge-a",
      "variant": "high",
      "agents": ["jd-judge-b"]
    },
    "judge-solo": {
      "description": "Single light-mode judge; cheap fast tier",
      "variant": null,
      "agents": ["jd-solo"]
    },
    "utility": {
      "description": "Cheap utility agents",
      "variant": null,
      "agents": ["english-tutor"]
    }
  }
}
